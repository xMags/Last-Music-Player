                                        <Button Width="184" VerticalAlignment="Top" Tag="fresh" Click="HomeMixCard_Click" AutomationProperties.Name="Play Fresh Finds" PointerEntered="PlaylistCard_PointerEntered" PointerExited="PlaylistCard_PointerExited" Style="{StaticResource CardButton}">
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Play now" Tag="fresh" Click="HomeMixMenuPlayNow_Click" />
                                                    <MenuFlyoutItem Text="Play next" Tag="fresh" Click="HomeMixMenuPlayNext_Click" />
                                                    <MenuFlyoutItem Text="Add to queue" Tag="fresh" Click="HomeMixMenuAddToQueue_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Shuffle" Tag="fresh" Click="HomeMixMenuShuffle_Click" />
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <StackPanel>
                                                <Border Width="184" Height="184" CornerRadius="{StaticResource Radius2xl}" Margin="0,0,0,10" Translation="0,0,16">
                                                    <Border.Shadow><ThemeShadow /></Border.Shadow>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FF2BD48F" Offset="0.0"/>
                                                            <GradientStop Color="#FF8BE36B" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D6;" FontSize="90" Foreground="White" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" IsHitTestVisible="False"/>
                                                        <Border IsHitTestVisible="False" CornerRadius="{StaticResource Radius2xl}">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
                                                                    <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Text="FRESH FINDS" FontSize="11" FontWeight="Bold" CharacterSpacing="180" Foreground="White" Opacity="0.95" VerticalAlignment="Top" Margin="14"/>
                                                        <TextBlock Text="The latest additions to your library." FontSize="12" FontWeight="Medium" Foreground="White" Opacity="0.94" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="17" VerticalAlignment="Bottom" Margin="14"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="Fresh Finds" Style="{StaticResource BodyStrong}"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Sits under the mixes row, as it does on web and
                                 Android. The mixes are built from the local
                                 library first and then blended with provider
                                 recommendations, so this is the only thing that
                                 distinguishes "still fetching" from "fetched and
                                 there was nothing to add". -->
                            <Grid x:Name="HomeMixStatusPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing x:Name="HomeMixProgressRing" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="HomeMixStatusText" Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <!-- Matches the web and Android ordering: mood collections
                             follow personal mixes and precede personal highlights. -->
                        <StackPanel x:Name="HomeCatalogMoodPanel" Visibility="Collapsed" />

                        <!-- Most Played Section. Populated from LoadMostPlayedTracks
                             (ordered by PlayCount). Section is initially collapsed and
                             revealed in C++ only when the user has at least a few
                             repeat-played tracks so we don't show an empty header on
                             first launch. -->
                        <StackPanel x:Name="HomeMostPlayedSection" Visibility="Collapsed">
                            <Grid Margin="0,0,0,16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <TextBlock Text="Most Played" Style="{StaticResource TitleH2}" />
                                    <Border Background="{ThemeResource NeutralFillBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="999" Padding="9,3" VerticalAlignment="Center">
                                        <TextBlock Text="TOP HITS" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="SemiBold" CharacterSpacing="40" />
                                    </Border>
                                </StackPanel>
                                <Button x:Name="HomeMostPlayedSeeAllButton" Content="See all &#x203A;" Click="HomeMostPlayedSeeAll_Click" AutomationProperties.Name="See all Most Played" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                            </Grid>
                            <Grid x:Name="HomeMostPlayedArrowHost">
                                <GridView x:Name="HomeMostPlayedGridView"
                                          Height="212"
                                          Padding="0,4,64,0"
                                          IsItemClickEnabled="True"
                                          ItemClick="HomeMostPlayed_ItemClick"
                                          ItemContainerStyle="{StaticResource CardTileContainerStyle}"
                                          SelectionMode="None"
                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="local:TrackInfo">
                                            <!-- Fixed-row grid so the artist line sits at the same
                                                 Y on every card regardless of title length. -->
                                            <Grid Width="156" Margin="0,0,20,0" VerticalAlignment="Top"
                                                  PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="156" />
                                                    <RowDefinition Height="12" />
                                                    <RowDefinition Height="22" />
                                                    <RowDefinition Height="18" />
                                                </Grid.RowDefinitions>
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="HomeRowMenuPlayNow_Click" />
                                                        <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNext_Click" />
                                                        <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAddToQueue_Click" />
                                                        <MenuFlyoutItem Text="Add to playlist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryRowMenuAddToPlaylist_Click" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="{x:Bind LikeActionText}" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuLike_Click" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Go to artist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuArtist_Click" />
                                                        <MenuFlyoutItem Text="Go to album" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAlbum_Click" />
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid Grid.Row="0" Width="156" Height="156">
                                                    <Border CornerRadius="{StaticResource Radius2xl}" Translation="0,0,16">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FFA042" Offset="0" />
                                                                <GradientStop Color="#FF3B6A" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Shadow>
                                                            <ThemeShadow />
                                                        </Border.Shadow>
                                                        <FontIcon Glyph="&#xE8D6;" FontSize="36" Foreground="White" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </Grid>
                        </StackPanel>

                        <!-- Liked Songs Highlights Section. Reads from the existing
                             "Liked" track filter. Hidden when the user hasn't liked
                             anything yet. -->
                        <StackPanel x:Name="HomeLikedSection" Visibility="Collapsed">
                            <Grid Margin="0,0,0,16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <TextBlock Text="Your Liked Songs" Style="{StaticResource TitleH2}" />
                                    <Border Background="{ThemeResource NeutralFillBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="999" Padding="9,3" VerticalAlignment="Center">
                                        <TextBlock Text="FAVOURITES" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="SemiBold" CharacterSpacing="40" />
                                    </Border>
                                </StackPanel>
                                <Button x:Name="HomeLikedSeeAllButton" Content="See all &#x203A;" Click="HomeLikedSeeAll_Click" AutomationProperties.Name="See all Favourites" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                            </Grid>
                            <Grid x:Name="HomeLikedArrowHost">
                                <GridView x:Name="HomeLikedGridView"
                                          Height="212"
                                          Padding="0,4,64,0"
                                          IsItemClickEnabled="True"
                                          ItemClick="HomeLiked_ItemClick"
                                          ItemContainerStyle="{StaticResource CardTileContainerStyle}"
                                          SelectionMode="None"
                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="local:TrackInfo">
                                            <Grid Width="156" Margin="0,0,20,0" VerticalAlignment="Top"
                                                  PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="156" />
                                                    <RowDefinition Height="12" />
                                                    <RowDefinition Height="22" />
                                                    <RowDefinition Height="18" />
                                                </Grid.RowDefinitions>
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="HomeRowMenuPlayNow_Click" />
                                                        <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNext_Click" />
                                                        <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAddToQueue_Click" />
                                                        <MenuFlyoutItem Text="Add to playlist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryRowMenuAddToPlaylist_Click" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="{x:Bind LikeActionText}" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuLike_Click" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Go to artist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuArtist_Click" />
                                                        <MenuFlyoutItem Text="Go to album" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAlbum_Click" />
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid Grid.Row="0" Width="156" Height="156">
                                                    <Border CornerRadius="{StaticResource Radius2xl}" Translation="0,0,16">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FF6BD0" Offset="0" />
                                                                <GradientStop Color="#C04BFE" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Shadow>
                                                            <ThemeShadow />
                                                        </Border.Shadow>
                                                        <FontIcon Glyph="&#xEB52;" FontSize="36" Foreground="White" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </Grid>
                        </StackPanel>

                        <!-- Recently Added Section. Hidden when no library tracks
                             have a meaningful DateAddedSortKey — search-result
                             remote tracks land with key=0 and would otherwise
                             dominate the carousel meaninglessly. Hidden state
                             matches Most Played + Liked Songs behaviour. -->
                        <StackPanel x:Name="HomeRecentlyAddedSection" Visibility="Collapsed">
                            <Grid Margin="0,0,0,16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <TextBlock Text="Recently Added" Style="{StaticResource TitleH2}" />
                                    <Border Background="{ThemeResource NeutralFillBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="999" Padding="9,3" VerticalAlignment="Center">
                                        <TextBlock Text="NEW" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" FontWeight="SemiBold" CharacterSpacing="40" />
                                    </Border>
                                </StackPanel>
                                <Button x:Name="HomeRecentlyAddedSeeAllButton" Content="See all &#x203A;" Click="HomeRecentlyAddedSeeAll_Click" AutomationProperties.Name="See all Recently Added" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                            </Grid>

                            <Grid x:Name="RecentlyAddedSkeletonHost" Visibility="Collapsed" Margin="0,4,0,24" />
                            <!-- Card shelf, matching Listen Again, Most Played and
                                 Liked Songs. This one used to be a two-column list
                                 of rows, which made it the odd one out among the
                                 personal shelves. -->
                            <Grid x:Name="HomeRecentlyAddedArrowHost">
                                <GridView x:Name="HomeRecentlyAddedGridView"
                                          Visibility="Collapsed"
                                          Height="212"
                                          Padding="0,4,64,0"
                                          IsItemClickEnabled="True"
                                          ItemClick="HomeRecentlyAdded_ItemClick"
                                          ItemContainerStyle="{StaticResource CardTileContainerStyle}"
                                          SelectionMode="None"
                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="local:TrackInfo">
                                            <Grid Width="156" Margin="0,0,20,0" VerticalAlignment="Top"
                                                  PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="156" />
                                                    <RowDefinition Height="12" />
                                                    <RowDefinition Height="22" />
                                                    <RowDefinition Height="18" />
                                                </Grid.RowDefinitions>
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="HomeRowMenuPlayNow_Click" />
                                                        <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNext_Click" />
                                                        <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAddToQueue_Click" />
                                                        <MenuFlyoutItem Text="Add to playlist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryRowMenuAddToPlaylist_Click" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="{x:Bind LikeActionText}" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuLike_Click" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Go to artist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuArtist_Click" />
                                                        <MenuFlyoutItem Text="Go to album" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAlbum_Click" />
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid Grid.Row="0" Width="156" Height="156">
                                                    <Border CornerRadius="{StaticResource Radius2xl}" Translation="0,0,16">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#14A8BC" Offset="0" />
                                                                <GradientStop Color="#7F6CFF" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Shadow>
                                                            <ThemeShadow />
                                                        </Border.Shadow>
                                                        <FontIcon Glyph="&#xE8D6;" FontSize="36" Foreground="White" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </Grid>

                            <!-- Empty state: shown until there are tracks in the library -->
                            <TextBlock x:Name="RecentlyAddedEmptyText"
                                       Text="Play something to see it here"
                                       Visibility="Collapsed"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                </Grid>
                </Grid>

                <!-- ========== BROWSE VIEW ========== -->
                <Grid x:Name="BrowseViewContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search Bar -->
                    <RowDefinition Height="*"/>    <!-- Results -->
                </Grid.RowDefinitions>

                <!-- Search Bar (outer wrapper emulates the CSS accent-soft focus glow) -->
                <Border x:Name="SearchGlow" Grid.Row="0" Margin="0,16,0,28" CornerRadius="22" BorderBrush="Transparent" BorderThickness="2" Padding="0">
                    <Border x:Name="SearchBorder" Margin="0" CornerRadius="20" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" Height="40" Padding="18,0,16,0" UseLayoutRounding="True">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="16" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <!-- Using TextBox styled as transparent to act as AutoSuggestBox without border -->
                            <TextBox x:Name="GlobalSearchBox" Grid.Column="1" PlaceholderText="Search songs, artists, albums, links..." AutomationProperties.Name="Search songs, artists, albums, links" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" GotFocus="GlobalSearchBox_GotFocus" LostFocus="GlobalSearchBox_LostFocus" KeyDown="GlobalSearchBox_KeyDown" TextChanged="GlobalSearchBox_TextChanged"/>
                            <Border Grid.Column="2" VerticalAlignment="Center" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{ThemeResource StrokeBrush}" Background="{ThemeResource NeutralFillBrush}" Padding="8,0" IsHitTestVisible="False">
                                <TextBlock Text="Ctrl + K" FontSize="11" FontWeight="SemiBold" CharacterSpacing="40" VerticalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,-16,0">
                <ScrollViewer x:Name="BrowseResultsContent" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="28" Padding="0,0,16,32">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock Text="Browse" Style="{StaticResource TitleH1}" />
                            <Border BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="SearchStatusText" Text="Browse" FontSize="10" Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="BrowseLandingPanel" Spacing="16">
                            <TextBlock x:Name="BrowseSearchHintText"
                                       Text="Type at least 2 characters to search."
                                       Visibility="Collapsed"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="Browse categories" Style="{StaticResource TitleH2}" />
                            <GridView x:Name="BrowseCategoryGrid"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="BrowseCategory_ItemClick"
                                      ItemContainerStyle="{StaticResource CardTileContainerStyle}"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="214" ItemHeight="112" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TrackInfo">
                                        <Grid Width="198" Height="96" Margin="0,0,16,16"
                                              PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                            <Border CornerRadius="{StaticResource Radius2xl}" Translation="0,0,16">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{ThemeResource AccentColor}" Offset="0" />
                                                        <GradientStop Color="{ThemeResource AccentColorLight}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Shadow>
                                                    <ThemeShadow />
                                                </Border.Shadow>
                                            </Border>
                                            <TextBlock Text="{x:Bind Title}"
                                                       Margin="18"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>

                        <StackPanel x:Name="BrowseSearchPanel" Visibility="Collapsed" Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="Results" Style="{StaticResource TitleH2}" />
                                    <TextBlock x:Name="SearchResultCountText" Text="0 results" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border CornerRadius="{StaticResource RadiusMd}" Background="{ThemeResource NeutralFillBrush}" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SearchListViewButton" Click="SearchListView_Click" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource RadiusSm}" Padding="8,5" AutomationProperties.Name="List view">
                                                <FontIcon Glyph="&#xEA37;" FontSize="14" Foreground="{ThemeResource TextTertiaryBrush}" />
                                            </Button>
                                            <Button x:Name="SearchGridViewButton" Click="SearchGridView_Click" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,5" AutomationProperties.Name="Grid view">
                                                <FontIcon Glyph="&#xE80A;" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <DropDownButton x:Name="SearchSortButton" CornerRadius="{StaticResource RadiusMd}" Padding="12,7">
                                        <TextBlock x:Name="SearchSortLabel" Text="Relevance" FontSize="12" FontWeight="SemiBold" />
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Relevance" Tag="Relevance" Click="SearchSort_Click" />
                                                <MenuFlyoutItem Text="Title" Tag="Title" Click="SearchSort_Click" />
                                                <MenuFlyoutItem Text="Artist" Tag="Artist" Click="SearchSort_Click" />
                                                <MenuFlyoutItem Text="Duration" Tag="Duration" Click="SearchSort_Click" />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="SearchLoadingText" Text="Searching music..." Visibility="Collapsed" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Grid x:Name="SearchSkeletonHost" Visibility="Collapsed" Margin="0,4,0,24" />

                            <StackPanel x:Name="SearchErrorPanel" Visibility="Collapsed" Spacing="8" Margin="0,18,0,18">
                                <TextBlock Text="Search unavailable" Style="{StaticResource TitleH2}" />
                                <TextBlock x:Name="SearchErrorMessageText" Text="Check your connection and try again." FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Button Content="Retry" Click="SearchRetry_Click" HorizontalAlignment="Left" Padding="16,8" CornerRadius="{StaticResource RadiusLg}" />
                            </StackPanel>

                            <StackPanel x:Name="SearchEmptyPanel" Visibility="Collapsed" Spacing="8" Margin="0,18,0,18">
                                <TextBlock x:Name="SearchEmptyTitleText" Text="No results" Style="{StaticResource TitleH2}" />
                                <TextBlock Text="Try another song, artist, album, or music link." FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>

                            <ListView x:Name="SearchResultsListView"
                                      Visibility="Collapsed"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="SearchResult_ItemClick"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="12,0" />
                                        <Setter Property="MinHeight" Value="64" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TrackInfo">
                                        <Grid Height="64" ColumnSpacing="12">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNow_Click" />
                                                    <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNext_Click" />
                                                    <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAddToQueue_Click" />
                                                    <MenuFlyoutItem Text="Add to playlist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryRowMenuAddToPlaylist_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="{x:Bind LikeActionText}" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuLike_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Go to artist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuArtist_Click" />
                                                    <MenuFlyoutItem Text="Go to album" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAlbum_Click" />
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="{StaticResource RadiusMd}" Background="{ThemeResource NeutralFillBrush}" VerticalAlignment="Center">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource PlaceholderGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Album}" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind SourceLabel}" VerticalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Duration}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <GridView x:Name="SearchSongsListView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="SearchResult_ItemClick"
                                      ItemContainerStyle="{StaticResource CardTileContainerStyle}"
                                      Padding="0,4,0,24"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="262" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TrackInfo">
                                        <Grid x:Name="SearchCardRoot" Width="146" Height="244" Margin="0,0,14,18" VerticalAlignment="Top"
                                              PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="146" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="40" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNow_Click" />
                                                    <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNext_Click" />
                                                    <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAddToQueue_Click" />
                                                    <MenuFlyoutItem Text="Add to playlist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryRowMenuAddToPlaylist_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="{x:Bind LikeActionText}" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuLike_Click" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Go to artist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuArtist_Click" />
                                                    <MenuFlyoutItem Text="Go to album" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAlbum_Click" />
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid Grid.Row="0" Width="146" Height="146">
                                                <Border CornerRadius="{StaticResource RadiusLg}" Background="{ThemeResource NeutralFillBrush}" Translation="0,0,16">
                                                    <Border.Shadow>
                                                        <ThemeShadow />
                                                    </Border.Shadow>
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="{ThemeResource PlaceholderGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                            </Grid>
                                            <TextBlock Grid.Row="2" Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="3" Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="4" Text="{x:Bind SourceLabel}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
                </Grid>

                <!-- ========== SETTINGS VIEW ========== -->
                <!-- Single scrolling page: every section is stacked top to bottom,
                     header included, so there is no section switcher to keep in sync. -->
                <Grid x:Name="SettingsViewContainer" Visibility="Collapsed" Padding="0,16,0,0">
                    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="32" Padding="0,0,4,32">

                            <StackPanel Spacing="4">
                                <TextBlock Text="PREFERENCES" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Settings" Style="{StaticResource TitleH1}" />
                                <TextBlock Text="Tune playback, library and appearance" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- ===== Account ===== -->
                            <!-- The operation mode decides where music comes from and, with it,
                                 who the app says you are: the identity card below shows the
                                 rename box on the local and API key modes, and the MagnetoFX
                                 profile on account mode. Sign-in and the API key fields stay
                                 visible in every mode on purpose, because RemoteMusicService
                                 only lets a mode be selected once that mode's own setup is
                                 already complete. -->
                            <StackPanel x:Name="SetSecAccount" Spacing="20">
                                <TextBlock Text="Account" Style="{StaticResource TitleH2}" TextWrapping="Wrap" />

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Operation mode" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                            <TextBlock Text="Where your music comes from. Local files remain available in every mode." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <RadioButtons x:Name="RemoteModeSelector" SelectionChanged="RemoteMode_SelectionChanged">
                                            <RadioButton x:Name="RemoteModeLocal" Content="Local files only" Tag="LocalOnly" />
                                            <RadioButton x:Name="RemoteModeAccount" Content="Account" Tag="Account" />
                                            <RadioButton x:Name="RemoteModeApiKey" Content="API key" Tag="ApiKey" />
                                        </RadioButtons>
                                    </StackPanel>
                                </Border>

                                <!-- Exactly one of these two panels is visible; C++ picks which
                                     from the resolved identity source. -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid x:Name="SettingsIdentityManualPanel" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource RadiusLg}" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="Display name" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Shown in the greeting, sidebar and 'Made for…' carousel." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                <Grid Margin="0,6,0,0" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" x:Name="DisplayNameBox" MaxLength="40" PlaceholderText="Listener" TextChanged="DisplayNameBox_TextChanged" KeyDown="DisplayNameBox_KeyDown" HorizontalAlignment="Stretch" />
                                                    <Button Grid.Column="1" x:Name="DisplayNameSaveButton" Click="DisplayNameSave_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="{StaticResource RadiusMd}" Padding="16,7" VerticalAlignment="Center" IsEnabled="False">
                                                        <TextBlock Text="Save" FontSize="12" FontWeight="SemiBold" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <Grid x:Name="SettingsIdentityAccountPanel" Visibility="Collapsed" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                <Grid>
                                                    <Image x:Name="AccountAvatarImage" Loaded="ArtworkImage_Loaded" Stretch="UniformToFill" Visibility="Collapsed" />
                                                    <FontIcon x:Name="AccountAvatarFallback" Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock x:Name="AccountDisplayNameText" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="AccountUsernameText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="AccountPlanText" Style="{StaticResource CaptionText}" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="Your name and picture come from your account. Rename yourself by switching to another operation mode." Style="{StaticResource CaptionText}" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <HyperlinkButton x:Name="AccountManageButton" Click="AccountManage_Click" Content="Manage account" Padding="0" MinHeight="0" HorizontalAlignment="Left" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Account connection" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="AccountStatusText" Text="Checking account status..." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="AccountSignInButton" Click="AccountSignIn_Click" CornerRadius="{StaticResource RadiusMd}" Padding="16,7" Content="Sign in" />
                                                <Button x:Name="AccountSyncButton" Click="AccountSync_Click" CornerRadius="{StaticResource RadiusMd}" Padding="16,7" Content="Sync now" Visibility="Collapsed" />
                                                <Button x:Name="AccountSignOutButton" Click="AccountSignOut_Click" CornerRadius="{StaticResource RadiusMd}" Padding="16,7" Content="Sign out" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Account library on this PC" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="AccountLastSyncText" Text="Not synchronized yet" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="AccountClearDataButton" Grid.Column="1" Click="AccountClearData_Click" CornerRadius="{StaticResource RadiusMd}" Padding="12,6" Content="Clear synced data" IsEnabled="False" />
                                        </Grid>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Keep this PC up to date" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Check for changes made on your other devices while the app is open." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AutoSyncSwitch" Grid.Column="1" IsOn="True" Toggled="SettingsToggle_Toggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="API key connection" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="ProviderTestStatusText" Text="Ready" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button x:Name="ProviderTestButton" Click="PlayProviderTest_Click" CornerRadius="{StaticResource RadiusMd}" Padding="16,7">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8FB;" FontSize="13" />
                                                    <TextBlock Text="Connect" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ProviderDisconnectButton" Click="DisconnectProvider_Click" CornerRadius="{StaticResource RadiusMd}" Padding="16,7" Content="Disconnect" />
                                        </StackPanel>
                                        <TextBox x:Name="ProviderBaseUrlBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="http://127.0.0.1:4527" Header="Provider URL" Margin="0,12,0,0" />
                                        <PasswordBox x:Name="ProviderApiKeyBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="API key" PasswordRevealMode="Peek" Margin="0,8,0,0" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ===== Library ===== -->
                            <StackPanel x:Name="SetSecLibrary" Spacing="20">
                                <!-- Scanning banner (shown while a scan runs) -->
                                <Border x:Name="SettingsScanCard" Visibility="Collapsed" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{ThemeResource AccentSoft2Brush}" BorderThickness="1" Padding="18,16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{ThemeResource AccentColor}" Offset="0.0" />
                                            <GradientStop Color="{ThemeResource PanelGradient1}" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{ThemeResource SurfaceBrush}" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE149;" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                            <TextBlock x:Name="ScanStatusText" Text="Scanning your music folder..." Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                            <ProgressBar IsIndeterminate="True" Foreground="{ThemeResource AccentBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Name="ScanCancelButton" Click="ScanCancel_Click" CornerRadius="{StaticResource RadiusMd}" Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="Cancel" FontSize="12" FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Library Management" Style="{StaticResource TitleH2}" TextWrapping="Wrap" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <!-- Music folder -->
                                        <Grid ColumnSpacing="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource RadiusLg}" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="Music folder" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="The folder scanned for your local library." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                <TextBox x:Name="MusicFolderPathBox" IsReadOnly="True" PlaceholderText="No folder selected" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                            <StackPanel x:Name="MusicFolderActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button x:Name="ChangeFolderButton" Click="ChangeFolderButton_Click" CornerRadius="{StaticResource RadiusMd}" Padding="14,7">
                                                    <TextBlock Text="Change" FontSize="12" FontWeight="SemiBold" />
                                                </Button>
                                                <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" CornerRadius="{StaticResource RadiusMd}" Padding="14,7">
                                                    <TextBlock Text="Open" FontSize="12" FontWeight="SemiBold" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16" />

                                        <!-- Scan for music -->
                                        <Grid ColumnSpacing="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource RadiusLg}" Background="{ThemeResource AccentSoftBrush}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE149;" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="Scan for music" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Re-index the selected folder for new or changed tracks." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" x:Name="ScanMusicButton" Click="ScanMusicButton_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="{StaticResource RadiusMd}" Padding="16,7" VerticalAlignment="Center">
                                                <TextBlock Text="Scan now" FontSize="12" FontWeight="SemiBold" />
                                            </Button>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16" />

                                    </StackPanel>
                                </Border>

                                <TextBlock Text="File Formats" Style="{StaticResource TitleH3}" TextWrapping="Wrap" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Formats included when scanning. Backend currently indexes MP3 and FLAC." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleButton x:Name="FmtMp3" Tag=".mp3" Content="MP3" IsChecked="True" Style="{StaticResource ChipToggle}" Checked="FormatChip_Toggled" Unchecked="FormatChip_Toggled" />
                                                <ToggleButton x:Name="FmtFlac" Tag=".flac" Content="FLAC" IsChecked="True" Style="{StaticResource ChipToggle}" Checked="FormatChip_Toggled" Unchecked="FormatChip_Toggled" />
                                                <ToggleButton x:Name="FmtWav" Tag=".wav" Content="WAV" Style="{StaticResource ChipToggle}" Checked="FormatChip_Toggled" Unchecked="FormatChip_Toggled" />
                                                <ToggleButton x:Name="FmtM4a" Tag=".m4a" Content="M4A" Style="{StaticResource ChipToggle}" Checked="FormatChip_Toggled" Unchecked="FormatChip_Toggled" />
                                                <ToggleButton x:Name="FmtAac" Tag=".aac" Content="AAC" Style="{StaticResource ChipToggle}" Checked="FormatChip_Toggled" Unchecked="FormatChip_Toggled" />
                                                <ToggleButton x:Name="FmtOgg" Tag=".ogg" Content="OGG" Style="{StaticResource ChipToggle}" Checked="FormatChip_Toggled" Unchecked="FormatChip_Toggled" />
                                                <ToggleButton x:Name="FmtOpus" Tag=".opus" Content="OPUS" Style="{StaticResource ChipToggle}" Checked="FormatChip_Toggled" Unchecked="FormatChip_Toggled" />
                                                <ToggleButton x:Name="FmtWma" Tag=".wma" Content="WMA" Style="{StaticResource ChipToggle}" Checked="FormatChip_Toggled" Unchecked="FormatChip_Toggled" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Playback ===== -->
                            <StackPanel x:Name="SetSecPlayback" Spacing="20">
                                <TextBlock Text="Playback" Style="{StaticResource TitleH2}" TextWrapping="Wrap" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Autoplay" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Keep playing related songs when your queue ends." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AutoplaySwitch" Grid.Column="1" IsOn="True" Toggled="SettingsToggle_Toggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Gapless playback" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Remove silence between consecutive tracks." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="GaplessSwitch" Grid.Column="1" IsOn="True" Toggled="SettingsToggle_Toggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="When closing window" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Choose what the close button does." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="CloseBehaviorCombo" Grid.Column="1" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="SettingsCombo_SelectionChanged">
                                                <ComboBoxItem Content="Minimize to tray" />
                                                <ComboBoxItem Content="Quit" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Audio ===== -->
                            <StackPanel x:Name="SetSecAudio" Spacing="20">
                                <TextBlock Text="Audio" Style="{StaticResource TitleH2}" TextWrapping="Wrap" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Output device" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Where audio is rendered." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="OutputDeviceCombo" Grid.Column="1" SelectedIndex="0" MinWidth="200" VerticalAlignment="Center" SelectionChanged="SettingsCombo_SelectionChanged">
                                                <ComboBoxItem Content="System default" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Equalizer" Style="{StaticResource TitleH3}" TextWrapping="Wrap" />
                                <TextBlock Text="Applies to local playback only. Cast playback uses the device's own audio processing." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Vertical" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleButton x:Name="EqPresetFlat" Tag="Flat" Content="Flat" Style="{StaticResource ChipToggle}" Click="EqualizerPreset_Click" IsEnabled="False" />
                                                <ToggleButton x:Name="EqPresetBass" Tag="Bass" Content="Bass Boost" Style="{StaticResource ChipToggle}" Click="EqualizerPreset_Click" IsEnabled="False" />
                                                <ToggleButton x:Name="EqPresetTreble" Tag="Treble" Content="Treble" Style="{StaticResource ChipToggle}" Click="EqualizerPreset_Click" IsEnabled="False" />
                                                <ToggleButton x:Name="EqPresetVocal" Tag="Vocal" Content="Vocal" Style="{StaticResource ChipToggle}" Click="EqualizerPreset_Click" IsEnabled="False" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleButton x:Name="EqPresetAcoustic" Tag="Acoustic" Content="Acoustic" Style="{StaticResource ChipToggle}" Click="EqualizerPreset_Click" IsEnabled="False" />
                                                <ToggleButton x:Name="EqPresetElectronic" Tag="Electronic" Content="Electronic" Style="{StaticResource ChipToggle}" Click="EqualizerPreset_Click" IsEnabled="False" />
                                                <ToggleButton x:Name="EqPresetCustom" Tag="Custom" Content="Custom" Style="{StaticResource ChipToggle}" IsEnabled="False" IsHitTestVisible="False" IsTabStop="False" ToolTipService.ToolTip="Highlights when bands do not match a preset" />
                                                <Button x:Name="EqResetButton" Click="EqResetButton_Click" ToolTipService.ToolTip="Zero all bands and preamp" IsEnabled="False">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE777;" FontSize="12" />
                                                        <TextBlock Text="Reset" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="Preamp" Style="{StaticResource CaptionText}" Width="60" VerticalAlignment="Center" />
                                            <Slider x:Name="EqPreampSlider" Minimum="-12" Maximum="0" Value="0" StepFrequency="1" Width="200" VerticalAlignment="Center" ValueChanged="EqPreampSlider_ValueChanged" ToolTipService.ToolTip="Reduce signal before the bands to give boosts headroom" IsEnabled="False" />
                                            <TextBlock x:Name="EqPreampValueText" Text="0 dB" Width="56" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel x:Name="EqualizerBars" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Appearance ===== -->
                            <StackPanel x:Name="SetSecAppearance" Spacing="20">
                                <TextBlock Text="Appearance" Style="{StaticResource TitleH2}" TextWrapping="Wrap" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Theme" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Switch between light, dark, or follow the system." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel x:Name="ThemeOptionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <ToggleButton x:Name="ThemeLight" Tag="Light" Content="Light" Style="{StaticResource ChipToggle}" Checked="ThemeSegment_Checked" />
                                                <ToggleButton x:Name="ThemeDark" Tag="Dark" Content="Dark" Style="{StaticResource ChipToggle}" Checked="ThemeSegment_Checked" />
                                                <ToggleButton x:Name="ThemeSystem" Tag="System" Content="System" IsChecked="True" Style="{StaticResource ChipToggle}" Checked="ThemeSegment_Checked" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Accent color" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Recolors highlights, sliders and accents across the app." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel x:Name="AccentSwatchesPanel" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Ellipse x:Name="AccentSw0" Tag="#FF0097B2" Width="22" Height="22" Fill="{ThemeResource AccentBrush}" Stroke="{ThemeResource StrokeStrongBrush}" StrokeThickness="2" Tapped="AccentSwatch_Tapped" />
                                                <Ellipse x:Name="AccentSw1" Tag="#FF6B8EFE" Width="22" Height="22" Fill="#FF6B8EFE" StrokeThickness="0" Tapped="AccentSwatch_Tapped" />
                                                <Ellipse x:Name="AccentSw2" Tag="#FFE0719C" Width="22" Height="22" Fill="#FFE0719C" StrokeThickness="0" Tapped="AccentSwatch_Tapped" />
                                                <Ellipse x:Name="AccentSw3" Tag="#FF6FBF73" Width="22" Height="22" Fill="#FF6FBF73" StrokeThickness="0" Tapped="AccentSwatch_Tapped" />
                                                <Ellipse x:Name="AccentSw4" Tag="#FFE8A33D" Width="22" Height="22" Fill="#FFE8A33D" StrokeThickness="0" Tapped="AccentSwatch_Tapped" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Show album art on player bar" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Display artwork next to the now-playing track." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="ShowAlbumArtSwitch" Grid.Column="1" IsOn="True" Toggled="SettingsToggle_Toggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== Integrations ===== -->
                            <StackPanel x:Name="SetSecIntegrations" Spacing="20">
                                <TextBlock Text="Integrations" Style="{StaticResource TitleH2}" TextWrapping="Wrap" />
                                <!-- Only meaningful while the catalog is reachable, so its
                                     visibility follows the same check as the catalog itself. -->
                                <Border x:Name="SettingsCatalogRegionCard" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Catalog region" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                            <TextBlock Text="Which country's Apple Music charts and featured music appear on Home." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="DiscoverStorefrontSelector" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="DiscoverStorefront_SelectionChanged" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Discord Rich Presence" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Show what you're listening to on Discord." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                <TextBlock Text="Requires the Discord desktop app to be running." Style="{StaticResource CaptionText}" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="DiscordPresenceSwitch" Grid.Column="1" Toggled="SettingsToggle_Toggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,16" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Windows media controls" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="System play/pause and media keys (SMTC)." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="WindowsMediaControlsSwitch" Grid.Column="1" IsOn="True" Toggled="SettingsToggle_Toggled" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== About ===== -->
                            <StackPanel x:Name="SetSecAbout" Spacing="20">
                                <TextBlock Text="About" Style="{StaticResource TitleH2}" TextWrapping="Wrap" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <Border Width="56" Height="56" CornerRadius="{StaticResource RadiusXl}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{ThemeResource AccentColor}" Offset="0.0" />
                                                        <GradientStop Color="{ThemeResource AccentColorLight}" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="&#x266A;" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Last Music Player" Style="{StaticResource TitleH3}" TextWrapping="Wrap" />
                                                <TextBlock Text="Version 1.0.0" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Build" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="Windows App SDK 1.8 · x64 · C++/WinRT (MSVC)" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Database" Style="{StaticResource EyebrowText}" />
                                            <TextBlock x:Name="AboutDbStats" Text="SQLite 3 · local library" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="OpenDataFolderButton" Click="OpenDataFolder_Click" CornerRadius="{StaticResource RadiusMd}" Padding="16,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xED43;" FontSize="14" />
                                                    <TextBlock Text="Open data folder" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="LicensesButton" Click="ShowLicenses_Click" CornerRadius="{StaticResource RadiusMd}" Padding="16,8">
                                                <TextBlock Text="Licenses &amp; credits" FontSize="12" FontWeight="SemiBold" />
                                            </Button>
                                            <Button x:Name="ResetDefaultsButton" Click="ResetDefaults_Click" CornerRadius="{StaticResource RadiusMd}" Padding="16,8">
                                                <TextBlock Text="Reset to defaults" FontSize="12" FontWeight="SemiBold" />
                                            </Button>
                                        </StackPanel>
                                        <Border Height="1" Background="{ThemeResource DividerBrush}" />
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{StaticResource RadiusLg}" Background="{ThemeResource DangerSoftBrush}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource DangerBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="Clean up everything" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="Wipe library, account cache, playback history, queues, settings, provider credentials and app caches." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="WipeAllDataStatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Visibility="Collapsed" />
                                            </StackPanel>
                                            <Button x:Name="WipeAllDataButton" Grid.Column="2" Click="WipeAllData_Click" Background="{ThemeResource DangerBrush}" Foreground="White" BorderThickness="0" CornerRadius="{StaticResource RadiusMd}" Padding="16,8" VerticalAlignment="Center">
                                                <TextBlock Text="Clean up" FontSize="12" FontWeight="SemiBold" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Full-size catalog subviews reached from Home. The catalog landing
                     content and region selector live directly in Home; this container
                     only owns chart, gallery, album, and playlist depth pages. -->
                <Grid x:Name="HomeCatalogViewContainer" Visibility="Collapsed" Padding="0,16,8,0">
                    <Grid.Resources>
                        <DataTemplate x:Key="CatalogTileTemplate" x:DataType="local:TrackInfo">
                            <Grid Width="156" Margin="0,0,20,0" VerticalAlignment="Top"
                                  PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="156" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="HomeRowMenuPlayNow_Click" />
                                        <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNext_Click" />
                                        <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAddToQueue_Click" />
                                        <MenuFlyoutItem Text="Add to playlist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryRowMenuAddToPlaylist_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="{x:Bind LikeActionText}" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuLike_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Go to artist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuArtist_Click" />
                                        <MenuFlyoutItem Text="Go to album" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAlbum_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid Grid.Row="0" Width="156" Height="156">
                                    <Border CornerRadius="{StaticResource Radius2xl}" Translation="0,0,16">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#14A8BC" Offset="0" />
                                                <GradientStop Color="#7F6CFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <FontIcon Glyph="&#xE8D6;" FontSize="36" Foreground="White" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Artwork is fetched per container rather than bound: it needs
                                         the account session, and a container only realizes when its
                                         tile scrolls into view. -->
                                    <Image Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                </Grid>
                                <TextBlock Grid.Row="2" Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="3" Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>

                        <!-- Same tile without the caption row, for shelves whose
                             items are playlists. There the subtitle only restates
                             the shelf ("Apple Music Fitness" under every mood
                             tile); on song and album shelves it is the artist,
                             which the template above keeps. -->
                        <DataTemplate x:Key="CatalogTileTitleOnlyTemplate" x:DataType="local:TrackInfo">
                            <Grid Width="156" Margin="0,0,20,0" VerticalAlignment="Top"
                                  PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="156" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="HomeRowMenuPlayNow_Click" />
                                        <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuPlayNext_Click" />
                                        <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAddToQueue_Click" />
                                        <MenuFlyoutItem Text="Add to playlist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryRowMenuAddToPlaylist_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="{x:Bind LikeActionText}" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuLike_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Go to artist" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuArtist_Click" />
                                        <MenuFlyoutItem Text="Go to album" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="BrowseRowMenuAlbum_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid Grid.Row="0" Width="156" Height="156">
                                    <Border CornerRadius="{StaticResource Radius2xl}" Translation="0,0,16">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#14A8BC" Offset="0" />
                                                <GradientStop Color="#7F6CFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <FontIcon Glyph="&#xE8D6;" FontSize="36" Foreground="White" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                </Grid>
                                <TextBlock Grid.Row="2" Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </Grid.Resources>

                    <!-- Full Explore Charts / City Charts gallery reached from Home. -->
                    <Grid x:Name="DiscoverChartGalleryPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,20">
                            <Button Click="DiscoverBack_Click" CornerRadius="{StaticResource RadiusLg}" Padding="12,7" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                    <TextBlock Text="Back" />
                                </StackPanel>
                            </Button>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Apple Music" Style="{StaticResource EyebrowText}" />
                                <TextBlock x:Name="DiscoverChartGalleryTitle" Text="Explore charts" Style="{StaticResource TitleH1}" />
                                <TextBlock x:Name="DiscoverChartGalleryStatus" Style="{StaticResource CaptionText}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled">
                            <VariableSizedWrapGrid x:Name="DiscoverChartGalleryPanel" Orientation="Horizontal" ItemWidth="184" ItemHeight="216" MaximumRowsOrColumns="20" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Chart page -->
                    <Grid x:Name="DiscoverChartPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,20">
                            <Button Click="DiscoverBack_Click" CornerRadius="{StaticResource RadiusLg}" Padding="12,7" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                    <TextBlock Text="Back" />
                                </StackPanel>
                            </Button>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="DiscoverChartKindText" Text="Chart" Style="{StaticResource EyebrowText}" />
                                <TextBlock x:Name="DiscoverChartTitleText" Text="Top Songs" Style="{StaticResource TitleH1}" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Enabled">
                            <StackPanel>
                                <Grid x:Name="DiscoverChartSkeletonHost" Visibility="Collapsed" Margin="0,4,0,24" />
                                <GridView x:Name="DiscoverChartGridView"
                                          IsItemClickEnabled="True"
                                          ItemClick="DiscoverItem_ItemClick"
                                          ItemContainerStyle="{StaticResource CardTileContainerStyle}"
                                          ItemTemplate="{StaticResource CatalogTileTemplate}"
                                          SelectionMode="None"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                <Button x:Name="DiscoverChartMoreButton" Content="Load more" Click="DiscoverChartMore_Click" Visibility="Collapsed" HorizontalAlignment="Center" CornerRadius="{StaticResource RadiusLg}" Padding="18,9" Margin="0,16,0,32" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Album / playlist detail -->
                    <Grid x:Name="DiscoverDetailPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="20" Margin="0,0,0,20">
                            <Button Click="DiscoverBack_Click" CornerRadius="{StaticResource RadiusLg}" Padding="12,7" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                    <TextBlock Text="Back" />
                                </StackPanel>
                            </Button>
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="180" Height="180" CornerRadius="{StaticResource Radius2xl}" Background="{ThemeResource NeutralFillBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D6;" FontSize="58" Foreground="{ThemeResource PlaceholderGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="DiscoverDetailArt" Loaded="ArtworkImage_Loaded" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock x:Name="DiscoverDetailKindText" Text="Album" Style="{StaticResource EyebrowText}" />
                                    <TextBlock x:Name="DiscoverDetailTitleText" Text="Collection" FontSize="38" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="WordEllipsis" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock x:Name="DiscoverDetailSubtitleText" Text="" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock x:Name="DiscoverDetailDescriptionText" Text="" FontSize="12.5" Foreground="{ThemeResource TextTertiaryBrush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                        <Button x:Name="DiscoverDetailPlayButton" Click="DiscoverDetailPlay_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="{StaticResource RadiusLg}" Padding="20,11">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                <TextBlock Text="Play" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DiscoverDetailQueueButton" Click="DiscoverDetailQueue_Click" CornerRadius="{StaticResource RadiusLg}" Padding="18,11">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                <TextBlock Text="Add to queue" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Grid x:Name="DiscoverDetailSkeletonHost" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Top" />
                        <ListView x:Name="DiscoverDetailTracksListView"
                                  Grid.Row="1"
                                  IsItemClickEnabled="True"
                                  ItemClick="DiscoverDetailTrack_ItemClick"
                                  ScrollViewer.VerticalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="52" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TrackInfo">
                                    <Grid Height="52" ColumnSpacing="12" Padding="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Index}" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="{StaticResource RadiusMd}" Background="{ThemeResource NeutralFillBrush}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8D6;" FontSize="15" Foreground="{ThemeResource PlaceholderGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Duration}" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- ========== LIBRARY VIEW ========== -->
                <Grid x:Name="LibraryViewContainer" Visibility="Collapsed" Padding="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Title block -->
                        <RowDefinition Height="Auto" /> <!-- Tabs -->
                        <RowDefinition Height="*" />    <!-- Content -->
                    </Grid.RowDefinitions>

                    <!-- Title block -->
                    <Grid x:Name="LibraryHeaderBar" Grid.Row="0" Margin="0,0,0,24" SizeChanged="LibraryHeaderBar_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="YOUR COLLECTION" Style="{StaticResource EyebrowText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="Library" Style="{StaticResource TitleH1}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="LibrarySubtitle" Text="Albums, artists and everything you've collected" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="LibraryImportStatusText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Library header actions. Each glyph is intentionally
                                 distinct so compact (icon-only) mode doesn't reduce
                                 multiple buttons to identical plus signs. -->
                            <Button x:Name="LibraryCreateAlbumButton" Click="LibraryCreateAlbum_Click" CornerRadius="{StaticResource RadiusLg}" Padding="12,8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE93C;" FontSize="16" />
                                    <TextBlock x:Name="LblCreateAlbum" Text="Create album" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibraryImportAlbumButton" Click="LibraryImportAlbum_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="{StaticResource RadiusLg}" Padding="12,8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                    <TextBlock x:Name="LblImportAlbum" Text="Import album" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibraryCreatePlaylistButton" Click="LibraryCreatePlaylist_Click" CornerRadius="{StaticResource RadiusLg}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE142;" FontSize="16" />
                                    <TextBlock x:Name="LblCreatePlaylist" Text="Create playlist" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibraryImportPlaylistButton" Click="LibraryImportPlaylist_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="{StaticResource RadiusLg}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                    <TextBlock x:Name="LblImportPlaylist" Text="Import playlist" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibraryAddFolderButton" Click="LibraryAddFolder_Click" CornerRadius="{StaticResource RadiusLg}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    <TextBlock x:Name="LblAddFolder" Text="Add folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tabs + account/local scope -->
                    <Grid x:Name="LibraryNavigationBar" Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleButton x:Name="LibTabPlaylists" Tag="Playlists" Content="Playlists" IsChecked="True" Style="{StaticResource ChipToggle}" Checked="LibraryTab_Checked" />
                            <ToggleButton x:Name="LibTabHistory" Tag="History" Content="History" Style="{StaticResource ChipToggle}" Checked="LibraryTab_Checked" />
                            <ToggleButton x:Name="LibTabMostPlayed" Tag="MostPlayed" Content="Most Played" Style="{StaticResource ChipToggle}" Checked="LibraryTab_Checked" />
                            <ToggleButton x:Name="LibTabAlbums" Tag="Albums" Content="Albums" Style="{StaticResource ChipToggle}" Checked="LibraryTab_Checked" />
                            <ToggleButton x:Name="LibTabArtists" Tag="Artists" Content="Artists" Style="{StaticResource ChipToggle}" Checked="LibraryTab_Checked" />
                            <ToggleButton x:Name="LibTabGenres" Tag="Genres" Content="Genres" Style="{StaticResource ChipToggle}" Checked="LibraryTab_Checked" />
                            <!-- Tag and element names stay "Songs": they are internal identifiers
                                 shared with a dozen controls in this panel. The tab shows
                                 only what is on disk, which is what the label says. -->
                            <ToggleButton x:Name="LibTabSongs" Tag="Songs" Content="Offline" Style="{StaticResource ChipToggle}" Checked="LibraryTab_Checked" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox x:Name="LibraryScopeSelector" Width="132" SelectedIndex="0" Visibility="Collapsed" SelectionChanged="LibraryScope_SelectionChanged">
                                <ComboBoxItem Content="All" Tag="All" />
                                <ComboBoxItem Content="Account" Tag="Account" />
                                <ComboBoxItem Content="On this PC" Tag="OnThisPc" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Tab content -->
                    <Grid x:Name="LibraryTabsContent" Grid.Row="2">
                        <!-- Albums -->
                        <Grid x:Name="LibraryTabsSkeletonHost" Visibility="Collapsed" VerticalAlignment="Top" />
                        <GridView ScrollViewer.VerticalScrollBarVisibility="Hidden" x:Name="LibAlbumsGrid" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="LibraryGroup_ItemClick" ItemContainerStyle="{StaticResource CardTileContainerStyle}" Padding="0,0,0,24"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:TrackInfo">
                                    <StackPanel Width="168" Margin="0,0,16,18" VerticalAlignment="Top" PointerEntered="PlaylistCard_PointerEntered" PointerExited="PlaylistCard_PointerExited">
                                        <StackPanel.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryGroupMenuPlayNow_Click" />
                                                <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryGroupMenuPlayNext_Click" />
                                                <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryGroupMenuAddToQueue_Click" />
                                                <MenuFlyoutItem Text="Shuffle" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryGroupMenuShuffle_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete album" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryAlbumDelete_Click" />
                                            </MenuFlyout>
                                        </StackPanel.ContextFlyout>
                                        <Border Width="160" Height="160" CornerRadius="{StaticResource Radius2xl}" Margin="0,0,0,10" Translation="0,0,16">
                                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF0097B2" Offset="0.0"/>
                                                    <GradientStop Color="#FF00B8D4" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <FontIcon Glyph="{x:Bind ArtworkGlyph}" FontSize="90" Foreground="White" Opacity="{x:Bind GeneratedArtworkOpacity}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" IsHitTestVisible="False" />
                                                <Border IsHitTestVisible="False" CornerRadius="{StaticResource Radius2xl}" Opacity="{x:Bind GeneratedArtworkOpacity}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="{x:Bind ArtworkTitle}" FontSize="11" FontWeight="Bold" CharacterSpacing="180" Foreground="White" Opacity="{x:Bind GeneratedArtworkOpacity}" VerticalAlignment="Top" Margin="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{x:Bind ArtworkCaption}" FontSize="12" FontWeight="Medium" Foreground="White" Opacity="{x:Bind GeneratedArtworkOpacity}" TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Bottom" Margin="14" MaxLines="3" TextTrimming="WordEllipsis" />
                                                <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" Opacity="{x:Bind ImageArtworkOpacity}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{x:Bind SourceLabel}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- Artists -->
                        <GridView ScrollViewer.VerticalScrollBarVisibility="Hidden" x:Name="LibArtistsGrid" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="LibraryGroup_ItemClick" ItemContainerStyle="{StaticResource CardTileContainerStyle}" Padding="0,0,0,24"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:TrackInfo">
                                    <StackPanel Width="168" Margin="0,0,16,18" VerticalAlignment="Top" PointerEntered="PlaylistCard_PointerEntered" PointerExited="PlaylistCard_PointerExited">
                                        <StackPanel.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Play now" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryGroupMenuPlayNow_Click" />
                                                <MenuFlyoutItem Text="Play next" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryGroupMenuPlayNext_Click" />
                                                <MenuFlyoutItem Text="Add to queue" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryGroupMenuAddToQueue_Click" />
                                                <MenuFlyoutItem Text="Shuffle" Tag="{x:Bind}" CommandParameter="{x:Bind}" Click="LibraryGroupMenuShuffle_Click" />
                                            </MenuFlyout>
                                        </StackPanel.ContextFlyout>
                                        <Border Width="144" Height="144" CornerRadius="72" Background="{ThemeResource NeutralFillBrush}" Margin="12,0,12,10" HorizontalAlignment="Center" Translation="0,0,12">
                                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                                            <Grid>
                                                <FontIcon Glyph="&#xE77B;" FontSize="44" Foreground="{ThemeResource PlaceholderGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Background="{ThemeResource NeutralFillBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="{x:Bind SourceLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- Songs -->
                        <Grid x:Name="LibrarySongsBrowser" Visibility="Collapsed" Padding="0,0,8,24">
                            <Grid.Resources>
                                <!-- Lightweight override: playing/selected row uses accent-soft -->
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource AccentColor}" Opacity="0.12" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource AccentColor}" Opacity="0.16" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource AccentColor}" Opacity="0.18" />
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Title block -->
                                <RowDefinition Height="Auto" /> <!-- Toolbar -->
                                <RowDefinition Height="Auto" /> <!-- Header row -->
                                <RowDefinition Height="*" />    <!-- Table -->
                            </Grid.RowDefinitions>

                            <!-- Title block -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock x:Name="SongsScopeLabel" Text="On this PC" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="Offline music" Style="{StaticResource TitleH1}" />
                                    <TextBlock x:Name="SongsSubtitle" Text="No tracks scanned yet" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Name="SongsRescanButton" Click="SongsRescan_Click" CornerRadius="{StaticResource RadiusLg}" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE149;" FontSize="14" />
                                            <TextBlock Text="Rescan" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SongsPlayAllButton" Click="SongsPlayAll_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="{StaticResource RadiusLg}" Padding="16,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="Play all" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Toolbar: filter chips + view toggle / sort -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- The filter chips that used to sit here duplicated
                                     destinations that already exist: History and Most
                                     Played are Library tabs, and Favourites is the
                                     system playlist the sidebar's Liked Songs opens. -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border CornerRadius="{StaticResource RadiusMd}" Background="{ThemeResource NeutralFillBrush}" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SongsListViewButton" Click="SongsListView_Click" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,5" AutomationProperties.Name="List view">
                                                <FontIcon Glyph="&#xEA37;" FontSize="14" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            </Button>
                                            <Button x:Name="SongsGridViewButton" Click="SongsGridView_Click" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource RadiusSm}" Padding="8,5" AutomationProperties.Name="Grid view">
                                                <FontIcon Glyph="&#xE80A;" FontSize="14" Foreground="{ThemeResource TextTertiaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <DropDownButton x:Name="SongsSortButton" CornerRadius="{StaticResource RadiusMd}" Padding="12,7">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="SongsSortLabel" Text="Date added" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Date added" Tag="DateAdded" Click="SongsSort_Click" />
                                                <MenuFlyoutItem Text="Title" Tag="Title" Click="SongsSort_Click" />
                                                <MenuFlyoutItem Text="Artist" Tag="Artist" Click="SongsSort_Click" />
                                                <MenuFlyoutItem Text="Duration" Tag="Duration" Click="SongsSort_Click" />
                                                <MenuFlyoutItem Text="Most played" Tag="MostPlayed" Click="SongsSort_Click" />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </Grid>

                            <!-- Header row -->
                            <Grid x:Name="SongsListHeader" Grid.Row="2" Padding="16,9" ColumnSpacing="10"
                                  Background="{ThemeResource SurfaceAltBrush}"
                                  BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="106" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource EyebrowText}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="TITLE" Style="{StaticResource EyebrowText}" />
                                <TextBlock Grid.Column="2" Text="ALBUM" Style="{StaticResource EyebrowText}" />
                                <TextBlock Grid.Column="3" Text="ADDED" Style="{StaticResource EyebrowText}" />
                                <TextBlock Grid.Column="4" Text="TIME" Style="{StaticResource EyebrowText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="" Style="{StaticResource EyebrowText}" />
                            </Grid>

                            <!-- Table -->
                            <Grid x:Name="SongsSkeletonHost" Grid.Row="3" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <ListView x:Name="MusicListView" Grid.Row="3"
                                      IsItemClickEnabled="True"
                                      ItemClick="MusicListView_ItemClick"
                                      ContainerContentChanging="SongsList_ContainerContentChanging"
                                      SelectionMode="Single"
                                      VerticalAlignment="Stretch"
                                      ScrollViewer.VerticalScrollMode="Enabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="16,0" />
                                        <Setter Property="MinHeight" Value="56" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TrackInfo">
                                        <Grid x:Name="RowRoot" Height="56" ColumnSpacing="10"
                                              PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="106" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>

                                            <!-- # / play (hover) -->
                                            <Grid Grid.Column="0">
                                                <TextBlock x:Name="RowNum" Text="{x:Bind Index}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="13" />
                                                <Button x:Name="RowPlay"
                                                        Tag="{x:Bind}"
                                                        Click="SongsRowPlay_Click"
                                                        Visibility="Collapsed"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        MinWidth="28"
                                                        Width="28"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Play track">
                                                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource AccentBrush}" />
                                                </Button>
                                            </Grid>

                                            <!-- Title / Artist -->
                                            <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="{StaticResource RadiusMd}" Background="{ThemeResource NeutralFillBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource PlaceholderGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                                            <Image Source="{x:Bind AlbumArt}" Stretch="UniformToFill" Loaded="AccountArtwork_Loaded" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </Grid>

