namespace Last_Music_Player
{
    [default_interface]
    [marshaling_behavior(agile)]
    [threading(both)]
    runtimeclass TrackInfo
    {
        TrackInfo();
        String Title;
        String Artist;
        Microsoft.UI.Xaml.Media.Imaging.BitmapImage AlbumArt;
        String ArtworkUrl;
        String ArtworkMode;
        String ArtworkTitle;
        String ArtworkCaption;
        String ArtworkGlyph;
        // Centre-glyph presentation for a generated cover. Only the system
        // playlists set these; everything else leaves the opacity at zero, so a
        // separate visibility flag is not needed. Segoe Fluent Icons draws some
        // of these glyphs filled and others as outlines, which is why the size
        // and opacity are per item rather than one shared constant.
        Double ArtworkGlyphOpacity;
        Double ArtworkGlyphSize;
        // Replaces the palette gradient that LibraryArtworkBorder_Loaded derives
        // from the item identity. Null for every item that should keep it.
        Microsoft.UI.Xaml.Media.Brush ArtworkBackground;
        Double ImageArtworkOpacity;
        Double GeneratedArtworkOpacity;
        Windows.Storage.StorageFile File;
        String FilePath;
        Double DurationSeconds;
        String Album;
        String Genre;
        String DateAdded;
        Double DateAddedSortKey;
        // Where playback last stopped in this track. Zero means start from the
        // beginning: it is cleared on a natural finish and never set for a stop
        // close to either end, so a resume offer always has something left.
        Double ResumePositionSeconds;
        // "2:14 left", or empty when there is nothing to resume.
        String ResumeCaption{ get; };
        Microsoft.UI.Xaml.Visibility ResumeCaptionVisibility{ get; };
        String Duration;
        Int32 Index;
        // Local database row id. Not a catalog identifier: account tracks store a
        // negated row id here. The catalog ids below are the remote ones.
        Int64 CatalogId;
        String RemoteId;
        String RemoteCatalogId;
        String AlbumCatalogId;
        String ArtistCatalogId;
        String SourceKind;
        String Provider;
        String SourceUrl;
        String SourceLabel;
        // Derived from SourceLabel: the card badge names the source only when
        // the item did not come from this PC, so a local-only library shows no
        // badges at all.
        String SourceBadgeText{ get; };
        Microsoft.UI.Xaml.Visibility SourceBadgeVisibility{ get; };
        Boolean IsLiked;
        String LikeActionText{ get; };
        // Paired visibilities for the two-glyph like control: a filled heart
        // and an outline heart stacked in the same cell, one of them shown.
        // A single glyph would need its Foreground swapped at runtime, which
        // a one-time binding cannot do and which would not survive a theme
        // change; two theme-bound icons do.
        Microsoft.UI.Xaml.Visibility LikedVisibility{ get; };
        Microsoft.UI.Xaml.Visibility UnlikedVisibility{ get; };
        // Whether the audio for this track is on this machine: a local file
        // that still exists, or a remote track with a published stream-cache
        // file. Set by the surface that builds the row, since deciding it
        // needs disk access that must not happen during binding.
        Boolean IsOffline;
        Microsoft.UI.Xaml.Visibility OfflineVisibility{ get; };
        // Search-result provenance. This is deliberately separate from
        // SourceKind: remote/account tracks can still be members of the local
        // library, while catalog-only hits are remote but not yet in it.
        Boolean IsInLibrary;
        Microsoft.UI.Xaml.Visibility InLibraryVisibility{ get; };
        // Whether an offline download is even possible for this row. Only a
        // remote track streamed over http(s) has anything to fetch; a local
        // file is already on the machine, so the menu hides the action rather
        // than offering one that can only report "already on this PC".
        Microsoft.UI.Xaml.Visibility DownloadVisibility{ get; };
        Int32 TrackCount;
    }
}
