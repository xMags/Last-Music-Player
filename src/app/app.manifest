<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="2.0.0.0" name="Last Music Player.app"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and later. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- The segment heap (Windows 10 2004 and later; older builds ignore this).
       Pages are rebuilt on every visit and each loads its covers again, which
       mixes short-lived picture buffers with small allocations. The default
       heap kept the gaps that left behind as committed free space, so memory
       grew with every visit while live data stayed level; the segment heap
       reuses and returns that space. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>

  <!-- DPI awareness is set by the UI framework at start-up. Declaring it here
       as well makes that call fail and log a warning. -->
</assembly>
