namespace Last_Music_Player
{
    [default_interface]
    [marshaling_behavior(agile)]
    [threading(both)]
    runtimeclass BrowseResultItem
    {
        BrowseResultItem();
        String Kind;
        String Title;
        String Subtitle;
        String Meta;
        String Key;
        String ArtworkUrl;
        Microsoft.UI.Xaml.Media.Imaging.BitmapImage ArtworkSource;
        Microsoft.UI.Xaml.CornerRadius ArtworkCornerRadius{ get; };
        Microsoft.UI.Xaml.TextAlignment GridTextAlignment{ get; };
    }
}
