<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Last Music Player: Design Tokens
        Theme-varying brushes/colors live in ThemeDictionaries (Light/Dark) and are
        consumed via {ThemeResource}. Theme-independent values (radii, sizes, text
        styles, control styles) live in the root dictionary below.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- Accent -->
            <Color x:Key="AccentColor">#FF0097B2</Color>
            <Color x:Key="AccentColorLight">#FF00B8D4</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0097B2" />
            <SolidColorBrush x:Key="AccentBrushLight" Color="#FF00B8D4" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F0097B2" />
            <SolidColorBrush x:Key="AccentSoft2Brush" Color="#330097B2" />
            <!-- Accent washes lighter than AccentSoftBrush, plus the border
                 weight that marks an accent-tinted container's edge. Ordered
                 selection < now-playing < soft < border so a selected row
                 inside a now-playing list still reads as distinct.
                 ApplyAccentColor recolors all of these in place and preserves
                 each brush's own alpha, so a new one added here must also be
                 probed in BrushProbes and captured in EnsureAccentBrushes or
                 it will keep the default teal after the user picks an accent. -->
            <SolidColorBrush x:Key="AccentSelectionBrush" Color="#140097B2" />
            <SolidColorBrush x:Key="AccentNowPlayingBrush" Color="#1A0097B2" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#470097B2" />
            <SolidColorBrush x:Key="PrimaryActionBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#FF0069B8" />

            <!-- Surfaces -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFBFBFD" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="ContentCanvasBrush" Color="#FFF7F7F8" />
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#FFFBFBFD" />
            <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FFFDFDFD" />
            <AcrylicBrush x:Key="CarouselArrowBackgroundBrush"
                          TintColor="#FFFFFFFF"
                          TintOpacity="0.64"
                          TintLuminosityOpacity="0.86"
                          FallbackColor="#F2FFFFFF" />
            <SolidColorBrush x:Key="CarouselArrowBorderBrush" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="CarouselArrowForegroundBrush" Color="#FF202124" />
            <SolidColorBrush x:Key="NeutralFillBrush" Color="#FFF3F4F6" />
            <SolidColorBrush x:Key="PlaceholderGlyphBrush" Color="#FFC7CDD4" />
            <!-- Distinctly darker than NeutralFillBrush, which sits at almost
                 exactly the luminance of the page gradient and disappears into
                 it. A skeleton has to read as a solid shape from across the
                 room, so it is pitched near the placeholder glyph instead. -->
            <SolidColorBrush x:Key="SkeletonFillBrush" Color="#FFDCE1E9" />

            <!-- Gradient stop colors -->
            <Color x:Key="PanelGradient1">#FFF0FCFF</Color>
            <Color x:Key="PanelGradient2">#FFF3F0FE</Color>
            <Color x:Key="ArtPlaceholderGrad1">#FFF3EDFC</Color>
            <Color x:Key="ArtPlaceholderGrad2">#FFFCF4FE</Color>
            <Color x:Key="ArtistTileGradient1">#FFF7F8FA</Color>
            <Color x:Key="ArtistTileGradient2">#FFEDEFF3</Color>
            <LinearGradientBrush x:Key="SelectedSourceBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFFFF" Offset="0" />
                <GradientStop Color="#120097B2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PanelHeaderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#1A0097B2" Offset="0" />
                <GradientStop Color="#050097B2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="MusicFolderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0F0097B2" Offset="0" />
                <GradientStop Color="#030097B2" Offset="1" />
            </LinearGradientBrush>

            <!-- Strokes & dividers -->
            <Color x:Key="StrokeStrongColor">#1A000000</Color>
            <SolidColorBrush x:Key="StrokeBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#12000000" />
            <SolidColorBrush x:Key="RowDividerBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="#06000000" />
            <!-- Buttons and segmented controls sit between the card hairline
                 (StrokeBrush) and the text-field edge (StrokeStrongBrush). -->
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#14000000" />
            <!-- Two hover weights above RowHoverBrush: the lighter one for rows
                 inside an already-elevated card, the heavier for bare controls. -->
            <SolidColorBrush x:Key="SubtleHoverBrush" Color="#08000000" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="InputUnderlineBrush" Color="#73000000" />
            <!-- Selection halo around the accent swatches. Heavier than the
                 hairline strokes so it reads as a marker, not an edge. -->
            <SolidColorBrush x:Key="SelectionRingBrush" Color="#40000000" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5C5C5C" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF8A8A8A" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#FFB4B4B4" />

            <!-- Player play/pause pill -->
            <SolidColorBrush x:Key="PlayerPlayBackground" Color="#FF1A202C" />
            <SolidColorBrush x:Key="PlayerPlayForeground" Color="#FFFFFFFF" />

            <!-- Misc brand -->
            <SolidColorBrush x:Key="LikedSongsBrush" Color="#FF6B8EFE" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFD83B3B" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FD83B3B" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF6FBF73" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFE8A33D" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Accent -->
            <Color x:Key="AccentColor">#FF0097B2</Color>
            <Color x:Key="AccentColorLight">#FF00B8D4</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0097B2" />
            <SolidColorBrush x:Key="AccentBrushLight" Color="#FF00B8D4" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E0097B2" />
            <SolidColorBrush x:Key="AccentSoft2Brush" Color="#470097B2" />
            <!-- Same ordering as Light, pitched up: a translucent wash over a
                 dark surface lifts far less than the same alpha over white. -->
            <SolidColorBrush x:Key="AccentSelectionBrush" Color="#1F0097B2" />
            <SolidColorBrush x:Key="AccentNowPlayingBrush" Color="#260097B2" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#660097B2" />
            <SolidColorBrush x:Key="PrimaryActionBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="PrimaryActionHoverBrush" Color="#FF0069B8" />

            <!-- Surfaces -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF272727" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="ContentCanvasBrush" Color="#FF242424" />
            <SolidColorBrush x:Key="TableHeaderBrush" Color="#FF272727" />
            <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FF303030" />
            <AcrylicBrush x:Key="CarouselArrowBackgroundBrush"
                          TintColor="#FF181818"
                          TintOpacity="0.58"
                          TintLuminosityOpacity="0.72"
                          FallbackColor="#EE242424" />
            <SolidColorBrush x:Key="CarouselArrowBorderBrush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="CarouselArrowForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NeutralFillBrush" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="PlaceholderGlyphBrush" Color="#FF5A5A5A" />
            <!-- Lifted off the dark panel gradient by roughly the same contrast
                 step the light theme uses, and tinted to match it rather than
                 going flat grey. -->
            <SolidColorBrush x:Key="SkeletonFillBrush" Color="#FF383F49" />

            <!-- Gradient stop colors -->
            <Color x:Key="PanelGradient1">#FF1D2329</Color>
            <Color x:Key="PanelGradient2">#FF21202B</Color>
            <Color x:Key="ArtPlaceholderGrad1">#FF2A2233</Color>
            <Color x:Key="ArtPlaceholderGrad2">#FF1F1D2A</Color>
            <Color x:Key="ArtistTileGradient1">#FF3C3C3C</Color>
            <Color x:Key="ArtistTileGradient2">#FF333333</Color>
            <LinearGradientBrush x:Key="SelectedSourceBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF2B2B2B" Offset="0" />
                <GradientStop Color="#260097B2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PanelHeaderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#330097B2" Offset="0" />
                <GradientStop Color="#140097B2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="MusicFolderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#240097B2" Offset="0" />
                <GradientStop Color="#0A0097B2" Offset="1" />
            </LinearGradientBrush>

            <!-- Strokes & dividers -->
            <Color x:Key="StrokeStrongColor">#24FFFFFF</Color>
            <SolidColorBrush x:Key="StrokeBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="RowDividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SubtleHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="InputUnderlineBrush" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="SelectionRingBrush" Color="#59FFFFFF" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC8C8C8" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF9A9A9A" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF6E6E6E" />

            <!-- Player play/pause pill -->
            <SolidColorBrush x:Key="PlayerPlayBackground" Color="#FFEDEDED" />
            <SolidColorBrush x:Key="PlayerPlayForeground" Color="#FF1A1A1A" />

            <!-- Misc brand -->
            <SolidColorBrush x:Key="LikedSongsBrush" Color="#FF6B8EFE" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B6B" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#29FF6B6B" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF6FBF73" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFE8A33D" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ===================== Theme-independent tokens ===================== -->

    <!-- Corner radius -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="Radius2xl">16</CornerRadius>
    <!-- The detail and browse surfaces use eleven distinct radii, more than the
         t-shirt scale above can name without inventing steps like "RadiusLgPlus".
         The in-between values are keyed by their literal size instead, so the
         XAML that consumes them can be read against the design without a lookup:
         7 segmented-control inner buttons and small artwork, 9 secondary buttons
         and toggle rows, 10 action-bar controls, 14 grid card artwork and tiles. -->
    <CornerRadius x:Key="Radius7">7</CornerRadius>
    <CornerRadius x:Key="Radius9">9</CornerRadius>
    <CornerRadius x:Key="Radius10">10</CornerRadius>
    <CornerRadius x:Key="Radius14">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Sizes -->
    <x:Double x:Key="NavItemHeight">42</x:Double>

    <!-- ===================== Text styles ===================== -->

    <!-- Detail-page hero title. LineHeight is the design's 1.05 ratio resolved
         at 40px; CharacterSpacing is in 1/1000 em, so -0.01em is -10. -->
    <Style x:Key="TitleHero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="42" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="TitleH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="TitleH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="TitleH3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <!-- Rail and panel headings: one step below TitleH2, still on the display
         face so it matches the section titles it sits under. -->
    <Style x:Key="TitlePanel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!-- Track-table column headers. Tighter tracking than EyebrowText (0.14em
         against 0.16em) because these sit in a dense row, not over open space. -->
    <Style x:Key="TableLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <!-- ===================== Control styles ===================== -->

    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource AccentColorLight}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource AccentColorLight}" />
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="{ThemeResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{ThemeResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{ThemeResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource AccentColorLight}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource AccentColorLight}" />

    <!-- The stock WinUI 1.8 template already has the target 40 x 20 track and
         12 x 12 knob. These local palette overrides make its states match the
         reference without replacing the accessible control template. -->
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{ThemeResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{ThemeResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{ThemeResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF0078D4" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF0069B8" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF0069B8" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF0078D4" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF0069B8" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF0069B8" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{ThemeResource TextSecondaryBrush}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{ThemeResource TextSecondaryBrush}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{ThemeResource TextSecondaryBrush}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White" />

    <!-- ToggleButton (filter chip) lightweight overrides: accent when checked -->
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource AccentColor}" Opacity="0.08" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource AccentColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource AccentColorLight}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource AccentColorLight}" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="White" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />

    <!-- 32x32 circular transparent icon button; subtle hover -->
    <Style x:Key="IconOnlyButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Frosted circular buttons over horizontally scrolling shelves. -->
    <Style x:Key="CarouselArrowButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{ThemeResource CarouselArrowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CarouselArrowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource CarouselArrowForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0.94">
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Opacity" Value="0.80" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stat card (Library view) -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="18,18" />
    </Style>

    <!-- Settings section card -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="DesignPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PrimaryActionBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="DesignSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SecondaryButtonBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- Detail-page action bar. Deliberately separate from DesignPrimaryButton
         and DesignSecondaryButton above: those are the Settings metrics
         (radius 6-8, 12-13px) and are consumed by shipped screens, so the
         action bar's heavier radius-10, 13.5px treatment gets its own keys
         rather than shifting theirs. Hover comes from WinUI's default button
         states, as it does everywhere else in this redesign. -->
    <Style x:Key="DetailActionPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PrimaryActionBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius10}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="DetailActionSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius10}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- Square 38x38 sibling of the above, for glyph-only actions. -->
    <Style x:Key="DetailActionIconButton" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius10}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="DesignChipToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="SourceModeCard" TargetType="RadioButton">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="MinHeight" Value="172" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Translation="0,0,4">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource SelectedSourceBrush}" />
                                        <Setter Target="Chrome.BorderBrush" Value="{ThemeResource AccentBrush}" />
                                        <Setter Target="Chrome.BorderThickness" Value="2" />
                                        <Setter Target="Chrome.Padding" Value="17" />
                                        <Setter Target="Chrome.Translation" Value="0,0,16" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Translation" Value="0,-2,16" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeTileToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.BorderBrush" Value="{ThemeResource AccentBrush}" />
                                        <Setter Target="Chrome.BorderThickness" Value="2" />
                                        <Setter Target="Chrome.Padding" Value="7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Chrome.Translation" Value="0,-1,4" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip (single-select pill) -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
    </Style>

    <!-- Card-tile GridView container: strips the stock GridViewItem chrome.
         The app's card tiles (home carousels, search results, Browse, and the
         Library album/artist/genre/playlist grids) all carry their own hover
         affordance (a -2px translate "lift" + ThemeShadow) and never use
         selection, so the stock subtle-fill pointer-over / pressed / selected
         overlay adds nothing — and with SelectionMode=None it sticks on the
         last-clicked (now-playing) tile, because PointerExited doesn't fire
         across the playback-triggered layout change, leaving a grey box that is
         also mis-sized against the tile (default MinWidth/Padding). This
         template is a bare ContentPresenter: no visual states, no min-size, no
         padding, so the container hugs the tile and paints no background.
         Keyboard focus still shows via the framework's system focus visual. -->
    <Style x:Key="CardTileContainerStyle" TargetType="GridViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A card that happens to be clickable. The tile paints itself, so the
         button contributes no chrome: bare ContentPresenter template, no
         visual states, no min-size, no padding. Unlike a panel with a Tapped
         handler this is focusable, invokes on Enter or Space, and reports
         itself to assistive tools as a button. Same shape as
         CardTileContainerStyle above, for cards that sit outside a GridView. -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit slider style: accent filled track + accent thumb -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
    </Style>

    <!-- One block of a loading skeleton. Callers give it the size of the
         content it stands in for, so the page lays out once and does not
         reflow when the real data arrives. The pulse that makes it read as
         loading is animated on the container, not on each block. -->
    <Style x:Key="SkeletonBlock" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SkeletonFillBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

</ResourceDictionary>
